# syntax=docker/dockerfile:1

ARG FRR_IMAGE=quay.io/frrouting/frr:containerlab-10.7.1
ARG FRR_VERSION=frr-10.7.1


# ============================================================
# Builder
# ============================================================

FROM ${FRR_IMAGE} AS builder

ARG FRR_VERSION

RUN apk add --no-cache \
    bash \
    ca-certificates \
    git \
    build-base \
    autoconf \
    automake \
    libtool \
    pkgconf \
    bison \
    flex \
    gawk \
    perl \
    texinfo \
    linux-headers \
    bsd-compat-headers \
    c-ares-dev \
    json-c-dev \
    readline-dev \
    ncurses-dev \
    pcre2-dev \
    libcap-dev \
    libedit-dev \
    util-linux-dev \
    elfutils-dev \
    openssl-dev \
    protobuf-c-dev \
    net-snmp-dev \
    python3-dev

WORKDIR /src

RUN git clone \
      --depth 1 \
      --branch ${FRR_VERSION} \
      https://github.com/FRRouting/frr.git \
      frr

WORKDIR /src/frr

RUN ./bootstrap.sh && \
    ./configure \
      --prefix=/usr \
      --sysconfdir=/etc \
      --localstatedir=/var \
      --sbindir=/usr/lib/frr \
      --libdir=/usr/lib \
      --with-moduledir=/usr/lib/frr/modules \
      --enable-vtysh \
      --enable-multipath=64 \
      --enable-vty-group=frrvty \
      --enable-user=frr \
      --enable-group=frr \
      --enable-pcre2posix \
      --enable-snmp && \
    make -j"$(nproc)" && \
    make DESTDIR=/out install

RUN test -f /out/usr/lib/frr/modules/bgpd_snmp.so && \
    test -f /out/usr/lib/frr/modules/zebra_snmp.so && \
    test -x /out/usr/lib/frr/bgpd && \
    test -x /out/usr/lib/frr/bfdd


# ============================================================
# Runtime
# ============================================================

FROM ${FRR_IMAGE}

RUN apk add --no-cache \
    net-snmp \
    net-snmp-tools \
    net-snmp-libs \
    net-snmp-agent-libs

COPY --from=builder /out/usr/ /usr/

RUN test -f /usr/lib/frr/modules/bgpd_snmp.so && \
    test -f /usr/lib/frr/modules/zebra_snmp.so && \
    test -x /usr/lib/frr/bgpd && \
    test -x /usr/lib/frr/bfdd && \
    command -v snmpd && \
    /usr/lib/frr/bgpd --version

EXPOSE 22/tcp
EXPOSE 179/tcp
EXPOSE 161/udp

# ENTRYPOINT/CMD are inherited from:
# quay.io/frrouting/frr:containerlab-10.7.1
