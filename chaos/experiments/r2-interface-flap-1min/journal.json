{
  "chaoslib-version": "1.45.0",
  "platform": "Linux-6.17.0-1021-raspi-aarch64-with-glibc2.42",
  "node": "pi02",
  "experiment": {
    "version": "1.0.0",
    "title": "R2 eth2 interface flap for 1 minute",
    "description": "Repeatedly shut down and restore R2 eth2. The interface stays down for 10 seconds and up for 10 seconds. This cycle is repeated three times.\n",
    "tags": [
      "containerlab",
      "network",
      "interface",
      "flap"
    ],
    "method": [
      {
        "type": "action",
        "name": "flap-r2-eth2-for-one-minute",
        "provider": {
          "type": "process",
          "path": "sh",
          "arguments": [
            "-c",
            "set -eu\n\nfor i in 1 2 3; do\n  echo \"=== Cycle ${i}/3: eth2 DOWN ===\"\n\n  docker exec clab-bgp-chaos-r2-frr \\\n    ip link set dev eth2 down\n\n  sleep 10\n\n  echo \"=== Cycle ${i}/3: eth2 UP ===\"\n\n  docker exec clab-bgp-chaos-r2-frr \\\n    ip link set dev eth2 up\n\n  sleep 10\ndone\n"
          ]
        }
      }
    ],
    "rollbacks": [
      {
        "type": "action",
        "name": "ensure-r2-eth2-is-up",
        "provider": {
          "type": "process",
          "path": "docker",
